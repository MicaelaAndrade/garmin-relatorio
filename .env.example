# Copie para .env e preencha. NUNCA comite o .env real.

# === Garmin Connect ===
# Sua conta Garmin Connect (mesma do app/site)
GARMIN_EMAIL=seu-email@exemplo.com
GARMIN_PASSWORD=sua-senha

# === Strava ===
# Crie um app em https://www.strava.com/settings/api (gratis, 1 minuto)
# Authorization Callback Domain: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# O refresh_token e gravado automaticamente em backend/data/strava_token.json
# apos o primeiro fluxo OAuth (rode: uv run python -m garmin_relatorio.cli strava-auth)

# === API ===
API_HOST=127.0.0.1
API_PORT=8000

# === Banco ===
DB_PATH=backend/data/garmin.db

# === Garmin GDPR Export (opcional) ===
# Caminho para a pasta DI_CONNECT do export "Manage Your Data > Export Your Data"
# Use isso pra carregar historico completo sem precisar logar no Garmin
# Ex Linux/Mac: /home/seu-usuario/Documentos/garmin-export/DI_CONNECT
# Ex Windows: C:\Users\seu-usuario\Documents\garmin-export\DI_CONNECT
GARMIN_EXPORT_DIR=

# === Claude API (opcional, pra resumo semanal natural) ===
# Sem chave: dashboard usa fallback template-based (funcional, menos natural)
# Pega em https://console.anthropic.com
ANTHROPIC_API_KEY=

# === Bundle CA customizado (opcional) ===
# Use isso se voce esta atras de proxy SSL corporativo (Netskope, Zscaler, etc).
# No Linux/Mac: /etc/ssl/certs/ca-certificates.crt
# No Windows: deixe em branco e use o cert importado no Windows store
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
